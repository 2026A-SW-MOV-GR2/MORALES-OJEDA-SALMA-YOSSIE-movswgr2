<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bereal_bg">

    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BeReal."
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/btnHeaderSend"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_send_plane"
        android:layout_marginEnd="20dp"
        android:contentDescription="Enviar"
        app:layout_constraintTop_toTopOf="@id/tvAppTitle"
        app:layout_constraintBottom_toBottomOf="@id/tvAppTitle"
        app:layout_constraintEnd_toStartOf="@id/btnHeaderBell" />

    <ImageView
        android:id="@+id/btnHeaderBell"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_bell"
        android:layout_marginEnd="16dp"
        android:contentDescription="Notificaciones"
        app:layout_constraintTop_toTopOf="@id/tvAppTitle"
        app:layout_constraintBottom_toBottomOf="@id/tvAppTitle"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/tabRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvAppTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tabMine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_mine"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:paddingHorizontal="8dp" />

        <TextView
            android:id="@+id/tabFof"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_fof"
            android:textColor="@color/bereal_text_secondary"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginStart="20dp"
            android:paddingHorizontal="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/notifBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_notif_banner"
        android:padding="16dp"
        android:layout_marginTop="18dp"
        android:layout_marginHorizontal="14dp"
        app:layout_constraintTop_toBottomOf="@id/tabRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_bell"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/notif_text"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:layout_marginStart="14dp" />

        <TextView
            android:id="@+id/btnActivateNotif"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notif_action"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="15sp"
            android:background="@drawable/ripple_white_button"
            android:paddingHorizontal="24dp"
            android:paddingVertical="14dp"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewFeed"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/notifBanner"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/notifBanner"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_sun"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ya está bien por hoy."
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/done_subtitle"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="14dp"
        android:background="@color/bereal_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_nav_home"
                android:contentDescription="@string/nav_home" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_home"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navFriends"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_nav_friends"
                android:alpha="0.5"
                android:contentDescription="@string/nav_friends" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_friends"
                android:textColor="@color/bereal_text_secondary"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/btnCamera"
                android:layout_width="66dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:padding="10dp"
                android:src="@drawable/ic_nav_camera"
                android:background="@drawable/bg_camera_pill"
                android:contentDescription="Tomar BeReal" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/navMemories"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_nav_memories"
                android:alpha="0.5"
                android:contentDescription="@string/nav_memories" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_memories"
                android:textColor="@color/bereal_text_secondary"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgProfile"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_user_felipe"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/CircleImage"
                android:contentDescription="@string/nav_profile" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_profile"
                android:textColor="@color/bereal_text_secondary"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
