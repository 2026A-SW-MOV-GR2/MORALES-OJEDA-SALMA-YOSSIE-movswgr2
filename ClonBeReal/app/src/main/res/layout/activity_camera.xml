<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Header -->
    <ImageView
        android:id="@+id/btnCloseCamera"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/ic_chevron_down"
        android:layout_marginTop="14dp"
        android:layout_marginStart="16dp"
        android:contentDescription="Cerrar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvCamTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BeReal."
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/btnCloseCamera"
        app:layout_constraintBottom_toBottomOf="@id/btnCloseCamera"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Preview con esquinas redondeadas -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/previewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintDimensionRatio="H,3:4"
        app:layout_constraintTop_toBottomOf="@id/btnCloseCamera"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Flash (izquierda) -->
        <ImageView
            android:id="@+id/btnFlash"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_margin="16dp"
            android:src="@drawable/ic_flash_off"
            android:contentDescription="Flash"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Zoom 1.0x (centro) -->
        <TextView
            android:id="@+id/tvZoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.0x"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_zoom_pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:layout_margin="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Voltear cámara (derecha) -->
        <ImageView
            android:id="@+id/btnFlip"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_margin="16dp"
            android:src="@drawable/ic_flip_camera"
            android:contentDescription="Voltear"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- VIDEO / FOTO -->
    <LinearLayout
        android:id="@+id/modeRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/previewContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIDEO"
            android:textColor="@color/bereal_text_secondary"
            android:textStyle="bold"
            android:textSize="15sp"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FOTO"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="15sp"
            android:background="@drawable/bg_button_white"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp" />
    </LinearLayout>

    <!-- Botón de disparo -->
    <FrameLayout
        android:id="@+id/btnShutter"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/modeRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_shutter_ring" />

        <View
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_shutter_inner" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>