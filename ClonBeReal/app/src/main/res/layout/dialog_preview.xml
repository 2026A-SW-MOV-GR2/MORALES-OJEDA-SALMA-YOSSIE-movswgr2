<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:paddingHorizontal="16dp">

    <!-- Header: chevron + BeReal. -->
    <ImageView
        android:id="@+id/btnClose"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/ic_chevron_down"
        android:layout_marginTop="14dp"
        android:contentDescription="Cerrar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BeReal."
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/btnClose"
        app:layout_constraintBottom_toBottomOf="@id/btnClose"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Caption -->
    <TextView
        android:id="@+id/tvCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/caption_hint"
        android:textColor="@color/bereal_text_secondary"
        android:textSize="20sp"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toBottomOf="@id/btnClose"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Contenedor de la foto (relación tipo BeReal) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/photoContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvCaption"
        app:layout_constraintBottom_toTopOf="@id/chipRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgMainPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedBerealImage"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="H,3:4" />

        <!-- Selfie superpuesta arriba-izquierda con borde -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgSelfiePreview"
            android:layout_width="110dp"
            android:layout_height="150dp"
            android:layout_margin="14dp"
            android:scaleType="centerCrop"
            android:padding="2dp"
            android:background="#000000"
            app:shapeAppearanceOverlay="@style/RoundedBerealImage"
            app:strokeColor="#000000"
            app:strokeWidth="2dp"
            app:layout_constraintTop_toTopOf="@id/imgMainPreview"
            app:layout_constraintStart_toStartOf="@id/imgMainPreview" />

        <!-- Texto "Toca aquí para cambiar tu leyenda" centrado -->
        <TextView
            android:id="@+id/tvTapCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tap_caption"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:shadowColor="#000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6"
            app:layout_constraintTop_toTopOf="@id/imgMainPreview"
            app:layout_constraintBottom_toBottomOf="@id/imgMainPreview"
            app:layout_constraintStart_toStartOf="@id/imgMainPreview"
            app:layout_constraintEnd_toEndOf="@id/imgMainPreview" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Fila de chips inferiores -->
    <LinearLayout
        android:id="@+id/chipRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnSend"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/chipAddFriend"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/ripple_chip"
            android:paddingHorizontal="18dp"
            android:layout_marginEnd="8dp">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_person_add"
                android:contentDescription="@null" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chipAudience"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/ripple_chip"
            android:paddingHorizontal="16dp"
            android:layout_marginEnd="8dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_lock"
                android:contentDescription="@null" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_mine"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chipLocation"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/ripple_chip"
            android:paddingHorizontal="16dp"
            android:layout_marginEnd="8dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_location"
                android:contentDescription="@null" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sí"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chipMusic"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/ripple_chip"
            android:paddingHorizontal="18dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_music"
                android:contentDescription="@null" />
        </LinearLayout>
    </LinearLayout>

    <!-- Botón ENVIAR -->
    <LinearLayout
        android:id="@+id/btnSend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="12dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/send"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="26sp" />
        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_send_plane"
            android:layout_marginStart="10dp"
            android:contentDescription="@null" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
