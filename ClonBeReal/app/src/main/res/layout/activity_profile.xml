<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bereal_bg"
    android:padding="24dp">

    <!-- Header -->
    <ImageView
        android:id="@+id/btnBackProfile"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/ic_chevron_down"
        android:rotation="90"
        android:layout_marginTop="8dp"
        android:contentDescription="Volver"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvProfileTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Perfil"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/btnBackProfile"
        app:layout_constraintBottom_toBottomOf="@id/btnBackProfile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Foto de perfil -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgProfilePhoto"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="48dp"
        android:src="@drawable/ic_user_felipe"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/CircleImage"
        app:layout_constraintTop_toBottomOf="@id/btnBackProfile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/btnChangePhoto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cambiar foto"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="14sp"
        android:background="@drawable/ripple_chip"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/imgProfilePhoto"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Nombre de usuario -->
    <TextView
        android:id="@+id/tvProfileUsername"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnChangePhoto"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Descripción -->
    <EditText
        android:id="@+id/etBio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="80dp"
        android:gravity="top|start"
        android:background="@drawable/bg_input_field"
        android:hint="Escribe una descripción…"
        android:textColorHint="@color/bereal_text_secondary"
        android:textColor="#FFFFFF"
        android:inputType="textMultiLine|textCapSentences"
        android:padding="16dp"
        android:layout_marginTop="28dp"
        android:importantForAutofill="no"
        app:layout_constraintTop_toBottomOf="@id/tvProfileUsername"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/btnSaveBio"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Guardar cambios"
        android:gravity="center"
        android:textColor="#000000"
        android:textStyle="bold"
        android:textSize="16sp"
        android:background="@drawable/ripple_white_button"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/etBio"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Cerrar sesión -->
    <TextView
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Cerrar sesión"
        android:gravity="center"
        android:textColor="#FF453A"
        android:textStyle="bold"
        android:textSize="16sp"
        android:background="@drawable/ripple_outline_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>